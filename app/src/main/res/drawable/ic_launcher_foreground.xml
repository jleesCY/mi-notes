<?xml version="1.0" encoding="utf-8"?>
<!-- mi. Notes' icon, "You are here": a big pencil in the app's yellow (#FFCC00), coming in from beyond the top left at
     45°, that has just written mi.'s dot (the full stop). Drawn on a 100-unit grid (see the mi-brand icons/make_icons.py),
     scaled to 46.7dp and centred on the 108dp adaptive canvas, so it fills 70% of the visible circle like every mi. glyph. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <group android:translateX="30.67" android:translateY="30.67" android:scaleX="0.467" android:scaleY="0.467">
        <!-- the pencil, drawn along x with its tip at the origin, then turned so it runs off the top left -->
        <group android:translateX="64" android:translateY="64" android:rotation="45" android:scaleX="1.3" android:scaleY="1.3">
            <path android:fillColor="#FFFFCC00" android:pathData="M-24,-17 L-3,-3 Q0,0 -3,3 L-24,17 Z M-77,-17 H-31 Q-28,-17 -28,-14 V14 Q-28,17 -31,17 H-77 Q-80,17 -80,14 V-14 Q-80,-17 -77,-17 Z M-94,-17 H-86 Q-84,-17 -84,-15 V15 Q-84,17 -86,17 H-94 Q-96,17 -96,15 V-15 Q-96,-17 -94,-17 Z M-130,-17 H-110 Q-100,-17 -100,-7 V7 Q-100,17 -110,17 H-130 Q-140,17 -140,7 V-7 Q-140,-17 -130,-17 Z" />
            <!-- where the sharpened wood meets the lead -->
            <path android:strokeColor="#FF0D0D0F" android:strokeWidth="3.5" android:pathData="M-9,-9 V9" />
        </group>
        <!-- mi.'s dot: the full stop the pencil just wrote (r 12 at 78,78 on every mi. icon) -->
        <path android:fillColor="#FFFFCC00" android:pathData="M66,78 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0 Z" />
    </group>
</vector>
